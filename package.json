{
  "name": "word-poker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "pnpm --filter @wordpoker/mobile start",
    "dev:server": "pnpm --filter @wordpoker/server start",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dictionary:prepare": "pnpm --filter @wordpoker/game-rules dictionary:prepare"
  }
}
