{
  "compilerOptions": {
    "target": "es2024",
    // Consumed as TypeScript source like the other packages: by tsx (apps/server, scripts) and by
    // Metro (apps/mobile's API routes), so bundler resolution and no `.js` specifiers.
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts"]
}
