# Copy to packages/db/.env. Process environment always wins over this file.
# DATABASE_URL takes precedence over POSTGRES_URL / POSTGRES_URI (PlanetScale-style names).

# Local container started by `pnpm db:up` (compose.yaml).
DATABASE_URL=postgresql://wordpoker:wordpoker@127.0.0.1:54329/wordpoker

# Tests create and drop run-scoped wordpoker_test_* databases from this server.
TEST_DATABASE_URL=postgresql://wordpoker:wordpoker@127.0.0.1:54329/wordpoker

# Escape hatch for db:reset against a non-local target. Leave unset locally.
ALLOW_DESTRUCTIVE_DB=
