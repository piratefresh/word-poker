# Local runs read apps/mobile/.env (the API routes, seed scripts, db:migrate and these tests).
# Process environment always wins over the file.
# DATABASE_URL takes precedence over POSTGRES_URL / POSTGRES_URI (PlanetScale-style names).

# The PlanetScale dev branch, never production: copy the string from the branch's Connect button.
# The auth pool reads DATABASE_HOST / _PORT / _USER / _PASSWORD / _NAME, so set those to the same branch.
DATABASE_URL=postgresql://<role>.<dev_branch_id>:<password>@<host>:5432/postgres?sslmode=verify-full&sslrootcert=system

# Tests create and drop run-scoped wordpoker_test_* databases (or schemas) on this server.
TEST_DATABASE_URL=

# The production branch id. Any local connection whose user ends in `.<id>` is refused
# (packages/db/src/production-guard.ts). ALLOW_PROD_DB=1 overrides it for a deliberate prod run.
PRODUCTION_DATABASE_BRANCH_ID=
ALLOW_PROD_DB=

# Connections per pool (auth, API ORM, room-server ORM; one of each per process). A PS-5 leaves
# about 12 of its 25 free, so the default is 3. Raise it only with a bigger cluster.
DATABASE_POOL_MAX=
