{
  "private": true,
  "name": "@wordpoker/server",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "start:prod": "node build/index.js",
    "loadtest": "tsx loadtest/example.ts --room game --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json --noEmit && node scripts/build.mjs",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "mocha": "^11.7.5",
    "pg": "^8.23.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/admin": "^0.18.6",
    "@colyseus/auth": "^0.18.4",
    "@colyseus/database": "^0.18.4",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@wordpoker/contracts": "workspace:*",
    "@wordpoker/db": "workspace:*",
    "@wordpoker/game-rules": "workspace:*",
    "colyseus": "^0.18.2",
    "expo-server": "^57.0.3",
    "express": "^5.2.1"
  }
}
