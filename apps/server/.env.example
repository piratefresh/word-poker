# Online seat verification uses the same Better Auth origin as mobile.
AUTH_API_URL=http://localhost:8081

# Same database as Better Auth and the mobile API; enables friends and history at the table.
# Run packages/db migrations before enabling.
WORDPOKER_DATABASE_URL=postgresql://postgres@localhost:5432/wordpoker

# Required with history enabled. Mount a persistent volume here, shared by all room workers.
# Retain it on process restart/redeploy; ephemeral storage cannot guarantee crash recovery.
# Keep separate directories for separate databases. Entries contain private hand data.
WORDPOKER_HISTORY_JOURNAL_DIR=./data/settlements
