{
  "name": "@wordpoker/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:check": "expo export --platform android --platform ios --output-dir .expo/export-check",
    "lint": "expo lint",
    "reset-project": "node ./scripts/reset-project.js",
    "test:auth": "tsx --test \"src/auth/server/*.test.mjs\""
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.4",
    "@colyseus/sdk": "0.18.2",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lilita-one": "^0.4.1",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@expo-google-fonts/roboto-slab": "^0.4.2",
    "@expo/ui": "~57.0.21",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "3.6.0",
    "@revenuecat/purchases-js": "^1.67.1",
    "@rive-app/canvas": "^2.44.0",
    "@rive-app/react-native": "^0.5.4",
    "@shopify/react-native-skia": "^2.6.2",
    "@wordpoker/contracts": "workspace:*",
    "@wordpoker/db": "workspace:*",
    "@wordpoker/economy": "workspace:*",
    "@wordpoker/game-rules": "workspace:*",
    "better-auth": "^1.7.4",
    "dotenv": "17.4.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "^57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-network": "^57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "express": "^5.2.1",
    "pg": "8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-purchases": "^10.11.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/pg": "8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "<rootDir>/jest-resolver.js",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|standard-navigation|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  }
}
