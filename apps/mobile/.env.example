# PostHog product analytics (public mobile build-time configuration)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Dev builds only: make the ad consent form (UMP) act as if the player were in EEA | REGULATED_US_STATE | NOT_EEA.
# EXPO_PUBLIC_ADS_DEBUG_GEOGRAPHY=EEA
# A phone (not an emulator) also needs its hashed id, which UMP logs on first run.
# EXPO_PUBLIC_ADS_TEST_DEVICE=
