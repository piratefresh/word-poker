{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @wordpoker/mobile exec expo export --platform web"
  },
  "deploy": {
    "startCommand": "node apps/mobile/server.cjs",
    "healthcheckPath": "/api/auth/ok",
    "restartPolicyType": "ON_FAILURE"
  }
}
